{
  "$schema": "https://opencode.ai/config.json",

  // Documentation projet chargée en plus d'AGENTS.md.
  "instructions": [
    "PRODUCT_VISION.md",
    "DOCS/DECISIONS.md",
    "DOCS/CI.md",
    "DOCS/MIGRATIONS.md",
    "DOCS/HEF_INTEGRATION.md"
  ],

  // Accès nommés au curriculum source et à la documentation.
  "references": {
    "hef": {
      "repository": "letriplenesty-ai/hashcode-engineering-foundations",
      "branch": "main",
      "description": "Curriculum source HEF : 17 modules, 169 missions, labs et projets"
    },
    "docs": {
      "path": "./DOCS",
      "description": "Décisions produit, CI, migrations et intégration HEF"
    }
  },

  // Évite de watcher les gros artefacts générés.
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".next/**",
      "coverage/**",
      "playwright-report/**",
      "test-results/**",
      "public/hef/slides-pdf/**",
      "public/uploads/**"
    ]
  },

  // Limite la taille des sorties pour ne pas saturer le contexte.
  "tool_output": {
    "max_lines": 4000,
    "max_bytes": 100000
  },

  "experimental": {
    "todo": true
  },

  // Serveurs MCP. Les outils sont désactivés globalement et activés
  // uniquement dans les sous-agents concernés (voir .opencode/agents/).
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--output-dir",
        "/tmp/opencode/playwright-mcp",
        "--console-level",
        "error"
      ],
      "enabled": true,
      "timeout": 180000
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/github-token}",
        "X-MCP-Toolsets": "context,issues,pull_requests,actions",
        "X-MCP-Readonly": "true"
      },
      "timeout": 60000
    }
  },

  // Règles ordonnées : la dernière règle qui matche gagne.
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "~/.config/opencode/github-token": "deny",
      "~/.config/gh/hosts.yml": "deny"
    },
    "edit": {
      "*": "allow",
      ".env*": "deny",
      "prisma/migrations/**": "ask"
    },
    "bash": {
      "*": "ask",

      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git remote -v": "allow",
      "git add *": "allow",
      "git commit *": "allow",

      "npm run *": "allow",
      "pnpm *": "allow",
      "npx prisma *": "allow",
      "npx vitest *": "allow",
      "npx eslint *": "allow",
      "npx tsc *": "allow",
      "npx tsx *": "allow",
      "node scripts/*": "allow",

      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "sed *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "jq *": "allow",

      // Opérations de fichiers basiques : pas de confirmation.
      "pwd": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "ln *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "tree *": "allow",
      "du *": "allow",
      "df *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",

      "docker ps *": "allow",
      "docker logs *": "allow",
      "docker inspect *": "allow",
      "docker exec db psql *": "allow",
      "curl *": "allow",

      "gh auth status *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh pr diff *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",

      "git push *": "allow",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "./deploy.sh *": "ask",
      "docker compose *": "ask",
      "gh issue create *": "allow",
      "gh issue comment *": "allow",
      "gh issue close *": "ask",
      "gh pr create *": "allow",
      "gh api *": "ask",

      "gh pr merge *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "ask",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "npx prisma migrate reset *": "deny",
      "pnpm prisma migrate reset *": "deny",
      "prisma migrate reset *": "deny",
      "npx prisma db push --force-reset *": "deny",
      "pnpm prisma db push --force-reset *": "deny",
      "npm exec prisma migrate reset *": "deny",
      "pnpm dlx prisma migrate reset *": "deny",

      // Le jeton GitHub ne doit jamais être lu par l'agent.
      "*github-token*": "deny",
      "*gh/hosts.yml*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/opencode/**": "allow",
      "/tmp/hef/**": "allow",
      "~/.local/share/opencode/repos/github.com/letriplenesty-ai/**": "allow"
    },

    // MCP : désactivés globalement, réactivés par sous-agent.
    "github_*": "deny",
    "playwright_*": "deny"
  }
}
