generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean
  image         String?
  level         Int          @default(1)
  experience    Int          @default(0)
  class         String?      @map("profile_class") // builder, creator, strategist, catalyst
  role          String       @default("MEMBER") // MEMBER, BUILDER, MENTOR, MODERATOR, OPERATOR, ADMIN
  createdAt     DateTime
  updatedAt     DateTime

  // 1. IDENTITY & BASIC
  pseudo        String?      @unique
  
  // 2. CONTEXT PERSONNEL
  country       String?
  city          String?
  language      String       @default("fr")
  ageRange      String?      // enum: 15-18, 18-25, 25-35, 35-50, 50+
  currentSituation String?   // Étudiant, Freelance, Salarié, Entrepreneur, Sans emploi, Reconversion

  // 3. CONTEXT TECHNIQUE
  technicalLevel String?     // Débutant, Intermédiaire, Avancé
  domains       String[]     // Web, Cybersecurity, Cloud, IA, Mobile, Data, Automation, UI/UX, DevOps
  tools         String[]     // GitHub, VS Code, Docker, Figma, Cursor, ChatGPT, Vercel, Linux
  githubUrl     String?
  portfolioUrl  String?

  // 4. OBJECTIFS UTILISATEUR
  mainObjective     String?  // Trouver emploi, Créer SaaS, Freelance, Créer startup, Cybersécurité, Maîtriser IA, Cloud Computing, Créer produits digitaux
  dominantMotivation String? // Argent, Passion, Impact, Curiosité, Carrière, Liberté, Innovation
  longTermObjective String?
  preferredRhythm    String? // Intensif, Progressif, Flexible, Week-end uniquement

  // 5. DONNÉES COMPORTEMENTALES
  onboardingSpeed     Int?     // Speed in ms
  answerConsistency   Float?   // Score 0-1
  connectionFrequency Float?   // Score 0-1
  dashboardActivity   Float?   // Score 0-1
  communityEngagement Float?   // Score 0-1

  // 6. DONNÉES PSYCHOMÉTRIQUES (Scores des classes)
  builderScore    Int @default(0)
  creatorScore    Int @default(0)
  strategistScore Int @default(0)
  catalystScore   Int @default(0)
  polarization    Float @default(0)
  profileStability Float @default(0)

  // 7. DONNÉES COMMUNAUTAIRES
  cohortsJoined         String[]
  collaborativeProjects String[]
  mentorId              String?
  mentor                User?    @relation("Mentorship", fields: [mentorId], references: [id])
  mentees               User[]   @relation("Mentorship")

  // 8. DONNÉES DE PROGRESSION
  projectsRealized      String[]
  activePaths           String[]
  badges                String[]
  missionsCompletedCount Int     @default(0)

  // 9. DONNÉES IA / RECOMMANDATION
  recommendedPath          String[]
  recommendedTools         String[]
  predictedEngagementScore Float?

  // RELATIONS
  sessions           Session[]
  accounts           Account[]
  quizResults        QuizResult[]
  guildMembers       GuildMember[]
  missionSubmissions MissionSubmission[]

  @@map("user")
}

model Guild {
  id            String        @id @default(cuid())
  name          String
  description   String?
  slug          String        @unique
  requiredLevel Int           @default(1)
  isPrivate     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  members       GuildMember[]

  @@map("guild")
}

model GuildMember {
  id        String   @id @default(cuid())
  userId    String
  guildId   String
  role      String   @default("MEMBER") // MEMBER, MODERATOR, LEADER
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId])
  @@map("guild_member")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model QuizResult {
  id                    String   @id @default(cuid())
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id])
  profileType           String   // builder, creator, strategist, catalyst
  score                 Int?
  answers               Json     // Store the raw answers for analysis
  averageResponseTime   Int?     @map("average_response_time") // Average time in ms
  detailedResponseTimes Json?    @map("detailed_response_times") // Array of times per question
  createdAt             DateTime @default(now())

  @@index([profileType])
  @@map("quiz_result")
}

model MissionSubmission {
  id          String   @id @default(cuid())
  userId      String
  missionId   String   // ID from the static missions list
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  content     String?  // The URL or text submitted by the user
  feedback    String?  // Feedback from the reviewer
  xpAwarded   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("mission_submission")
}
