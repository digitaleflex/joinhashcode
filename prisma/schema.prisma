generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String              @id
  name                     String
  email                    String              @unique
  emailVerified            Boolean
  emailStatus              String              @default("VALID") // VALID, BOUNCED, COMPLAINED
  emailLastBounced         DateTime?
  image                    String?
  createdAt                DateTime
  updatedAt                DateTime
  level                    Int                 @default(1)
  experience               Int                 @default(0)
  class                    String?             @map("profile_class")
  role                     String              @default("MEMBER")
  badges                   String[]
  behavioralVibrancy       Json?
  builderScore             Int                 @default(0)
  catalystScore            Int                 @default(0)
  cardSignature            String?             @unique
  cardIssuedAt             DateTime?
  cardTier                 String?             @default("STANDARD")
  city                     String?
  confidenceScore          Float               @default(0.25)
  country                  String?
  creatorScore             Int                 @default(0)
  currentSituation         String?
  domains                  String[]
  githubUrl                String?
  language                 String              @default("fr")
  lastHypothesisUpdate     DateTime?
  mainObjective            String?
  missionsCompletedCount   Int                 @default(0)
  portfolioUrl             String?
  pseudo                   String?             @unique
  strategistScore          Int                 @default(0)
  technicalLevel           String?
  tools                    String[]
  secondaryObjectives      String[]
  bio                      String?
  linkedinUrl              String?
  memberNumber             Int                 @unique @default(autoincrement())
  twitterUrl               String?
  currentFocus             String[]
  dreamStatement           String?
  lastCheckinAt            DateTime?
  currentStreak            Int       @default(0)
  longestStreak            Int       @default(0)
  lastStreakDate           DateTime?
  mainBlocker              String?
  banned                   Boolean?            @default(false)
  banReason                String?
  banExpires               DateTime?
  accounts                 Account[]
  dailyCheckins            DailyCheckin[]
  guildMembers             GuildMember[]
  missionSubmissions       MissionSubmission[] @relation("SubmissionOwner")
  submissionsInReview      MissionSubmission[] @relation("SubmissionReviewer")
  canReviewProfiles        String[]        @default([])
  reviewsCompleted         Int             @default(0)
  reviewsGiven             MissionReview[] @relation("ReviewsGiven")
  notifications            Notification[]
  betaFeedbacks            BetaFeedback[]
  activityLogs             ActivityLog[]
  quizResults              QuizResult[]
  sessions                 Session[]
  members                  Member[]
  twoFactorEnabled         Boolean             @default(false)
  twoFactorSecret          String?
  twoFactorBackupCodes     String?
  invitations              Invitation[]
  joinRequests             JoinRequest[]
  betaKeyId                String?             @unique
  betaKey                  BetaKey?            @relation("UserBetaKey", fields: [betaKeyId], references: [id])

  @@index([level])
  @@index([class])
  @@index([role])
  @@map("user")
}

model Organization {
  id            String       @id
  name          String
  slug          String?      @unique
  logo          String?
  createdAt     DateTime
  metadata      String?
  cohesionScore Float        @default(0.1)
  streakCount   Int          @default(0)
  lastStreakAt  DateTime?
  requiredLevel Int          @default(1)
  isPrivate     Boolean      @default(false)
  description   String?
  announcement  String?
  members       Member[]
  twoFactorEnabled         Boolean             @default(false)
  twoFactorSecret          String?
  twoFactorBackupCodes     String?
  invitations   Invitation[]
  joinRequests             JoinRequest[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String
  status         String
  expiresAt      DateTime
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
  @@map("activity_log")
}

model DailyCheckin {
  id        String   @id @default(cuid())
  userId    String
  note      String   @db.VarChar(150)
  domain    String
  energy    Int
  duration  Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("daily_checkin")
}

model Mission {
  id               String              @id @default(cuid())
  title            String
  description      String
  slug             String              @unique
  category         String
  difficulty       Int                 @default(1)
  xp               Int                 @default(100)
  weightBuilder    Float               @default(0)
  weightCreator    Float               @default(0)
  weightStrategist Float               @default(0)
  weightCatalyst   Float               @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  duration         String?
  missionLevel     String?
  requirements     String[]
  shortDesc        String?
  targetProfiles   String[]
  deliverables     String[]
  fullBriefing     String?
  submissionMethod    String              @default("ANY_LINK")
  acceptanceCriteria  Json                @default("[]")
  evaluatorNotes      String?
  qualityIndicators   Json                @default("[]")
  isWeeklyChallenge Boolean             @default(false)
  weeklySlot        Int?
  submissions         MissionSubmission[]

  @@index([category])
  @@index([difficulty])
  @@map("mission")
}

model Guild {
  id            String        @id @default(cuid())
  name          String
  description   String?
  slug          String        @unique
  requiredLevel Int           @default(1)
  isPrivate     Boolean       @default(false)
  cohesionScore Float         @default(0.1) // Tracks squad engagement (0 to 1)
  streakCount   Int           @default(0)   // New: Consecutive days at high cohesion
  lastStreakAt  DateTime?                   // New: Last time the streak was updated
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  members       GuildMember[]

  @@map("guild")
}

model GuildMember {
  id       String   @id @default(cuid())
  userId   String
  guildId  String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId])
  @@index([userId])
  @@index([guildId])
  @@map("guild_member")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  activeOrganizationId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model QuizResult {
  id                    String   @id @default(cuid())
  userId                String?
  profileType           String
  score                 Int?
  answers               Json
  createdAt             DateTime @default(now())
  averageResponseTime   Int?     @map("average_response_time")
  user                  User?    @relation(fields: [userId], references: [id])

  @@index([profileType])
  @@index([userId])
  @@map("quiz_result")
}

model MissionSubmission {
  id                     String   @id @default(cuid())
  userId                 String
  missionId              String
  cycleKey               String   @default("PERMANENT")
  status                 String   @default("PENDING")
  content                String?
  xpAwarded              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  improvementSuggestions String?
  projectDescription     String?
  reviewerFeedback       String?
  userDifficulty         Int?
  userFeedback           String?
  userRating             Int?
  adminFeedback          String?
  reviewerId             String?
  qualityLevel           String?
  revisionCount          Int      @default(0)
  revisionNotes          String?
  reviewerType           String?
  mission                Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user                   User     @relation("SubmissionOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer               User?    @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  reviews                MissionReview[]

  @@unique([userId, missionId, cycleKey])
  @@index([status])
  @@index([userId])
  @@index([missionId])
  @@index([createdAt])
  @@map("mission_submission")
}

model MissionReview {
  id            String            @id @default(cuid())
  submissionId  String
  reviewerId    String?
  criteria      Json
  qualityLevel  String
  feedback      String
  revisionNotes String?
  createdAt     DateTime          @default(now())
  submission    MissionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer      User?             @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([submissionId, reviewerId])
  @@index([submissionId])
  @@index([reviewerId])
  @@map("mission_review")
}

model ContactMessage {
  id        String   @id @default(cuid())
  type      String
  email     String
  subject   String
  content   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())

  @@index([type])
  @@index([status])
  @@map("contact_message")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notification")
}

model BetaFeedback {
  id            String   @id @default(cuid())
  userId        String
  type          String   // e.g., "BUG", "FEATURE_REQUEST", "GENERAL"
  content       String   @db.Text
  status        String   @default("NEW") // e.g., "NEW", "REVIEWED", "RESOLVED"
  attachmentUrl String?  // URL of any attached file (screenshot, etc.)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("beta_feedback")
}

model JoinRequest {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress      String?
  userAgent      String?

  @@unique([userId, organizationId])
  @@map("join_request")
}

model BetaKey {
  id        String    @id @default(cuid())
  key       String    @unique
  isUsed    Boolean   @default(false)
  usedBy    String?   @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User?     @relation("UserBetaKey")

  @@map("beta_key")
}

