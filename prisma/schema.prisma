generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String              @id
  name                     String
  email                    String              @unique
  emailVerified            Boolean
  emailStatus              String              @default("VALID") // VALID, BOUNCED, COMPLAINED
  emailLastBounced         DateTime?
  image                    String?
  createdAt                DateTime
  updatedAt                DateTime
  class                    String?             @map("profile_class")
  role                     String              @default("MEMBER")
  badges                   String[]
  behavioralVibrancy       Json?
  cardSignature            String?             @unique
  cardIssuedAt             DateTime?
  cardTier                 String?             @default("STANDARD")
  city                     String?
  country                  String?
  currentSituation         String?
  domains                  String[]
  language                 String              @default("fr")
  lastHypothesisUpdate     DateTime?
  mainObjective            String?
  pseudo                   String?             @unique
  technicalLevel           String?
  tools                    String[]
  secondaryObjectives      String[]
  bio                      String?
  memberNumber             Int                 @unique @default(autoincrement())
  currentFocus             String[]
  dreamStatement           String?
  mainBlocker              String?
  banReason                String?
  banExpires               DateTime?
  visitorId                String?
  consentLocation          Boolean             @default(false)
  consentLocationAt        DateTime?
  latitude                 Float?
  longitude                Float?
  locationAccuracy         Float?
  locationUpdatedAt        DateTime?
  ipCountry                String?


  // Relations spécialisées
  psychometrics            Psychometric?
  socials                  UserSocials?
  stats                    EngagementStats?
  security                 UserSecurity?
  referral                 UserReferral?
  progress                 UserProgress?
  beta                     UserBeta?
  accounts                 Account[]
  dailyCheckins            DailyCheckin[]
  guildMembers             GuildMember[]
  missionSubmissions       MissionSubmission[] @relation("SubmissionOwner")
  submissionsInReview      MissionSubmission[] @relation("SubmissionReviewer")
  canReviewProfiles        String[]        @default([])
  reviewsCompleted         Int             @default(0)
  reviewsGiven             MissionReview[] @relation("ReviewsGiven")
  notifications            Notification[]
  betaFeedbacks            BetaFeedback[]
  activityLogs             ActivityLog[]
  quizResults              QuizResult[]
  uxPollResponses          UXPollResponse[]
  sessions                 Session[]
  members                  Member[]
  twoFactorBackupCodes     String?
  invitations              Invitation[]
  joinRequests             JoinRequest[]
  twofactors               TwoFactor[]
  passkeys                 Passkey[]
  xpTransactions           XpTransaction[]
  squadMessages            SquadMessage[]
  fraudEvents              FraudEvent[]
  locations                UserLocation[]

  @@index([class])
  @@index([role])
  @@index([createdAt])
  @@map("user")
}

model UserSecurity {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  fraudRiskScore  Int      @default(0)
  banned          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_security")
}

model UserReferral {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode   String   @unique
  referrerId     String?
  referralCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("user_referral")
}

model UserProgress {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level                Int      @default(1)
  experience           Int      @default(0)
  missionsCompletedCount Int    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([experience])
  @@index([level])
  @@map("user_progress")
}

model UserBeta {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  betaKeyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_beta")
}

model Organization {
  id            String       @id
  name          String
  slug          String?      @unique
  logo          String?
  createdAt     DateTime
  metadata      String?
  cohesionScore Float        @default(0.1)
  streakCount   Int          @default(0)
  lastStreakAt  DateTime?
  requiredLevel Int          @default(1)
  isPrivate     Boolean      @default(false)
  description   String?
  announcement  String?
  members       Member[]
  twoFactorEnabled         Boolean             @default(false)
  twoFactorSecret          String?
  twoFactorBackupCodes     String?
  invitations   Invitation[]
  joinRequests             JoinRequest[]
  messages      SquadMessage[]

  @@index([isPrivate, cohesionScore(sort: Desc), streakCount(sort: Desc)])
  @@index([isPrivate, createdAt(sort: Desc)])
  @@map("organization")
}

model SquadMessage {
  id             String       @id @default(cuid())
  content        String       @db.Text
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
  @@map("squad_message")
}

model Member {
  id             String       @id
  organizationId String
  userId         String       @unique
  role           String
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String
  status         String
  expiresAt      DateTime
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@index([status])
  @@map("invitation")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@map("activity_log")
}

model DailyCheckin {
  id        String   @id @default(cuid())
  userId    String
  note      String   @db.VarChar(150)
  domain    String
  energy    Int
  duration  Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("daily_checkin")
}

model Mission {
  id               String              @id @default(cuid())
  title            String
  description      String
  slug             String              @unique
  category         String
  difficulty       Int                 @default(1)
  xp               Int                 @default(100)
  weightBuilder    Float               @default(0)
  weightCreator    Float               @default(0)
  weightStrategist Float               @default(0)
  weightCatalyst   Float               @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  duration         String?
  missionLevel     String?
  requirements     String[]
  shortDesc        String?
  targetProfiles   String[]
  deliverables     String[]
  fullBriefing     String?
  submissionMethod    String              @default("ANY_LINK")
  acceptanceCriteria  Json                @default("[]")
  evaluatorNotes      String?
  qualityIndicators   Json                @default("[]")
  isWeeklyChallenge Boolean             @default(false)
  weeklySlot        Int?
  submissions         MissionSubmission[]

  @@index([category])
  @@index([difficulty])
  @@map("mission")
}


model Guild {
  id            String        @id @default(cuid())
  name          String
  description   String?
  slug          String        @unique
  requiredLevel Int           @default(1)
  isPrivate     Boolean       @default(false)
  cohesionScore Float         @default(0.1)
  streakCount   Int           @default(0)
  lastStreakAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  members       GuildMember[]

  @@map("guild")
}

model GuildMember {
  id       String   @id @default(cuid())
  userId   String
  guildId  String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId])
  @@index([userId])
  @@index([guildId])
  @@map("guild_member")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  impersonatedBy String?
  activeOrganizationId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt, token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model QuizResult {
  id                    String   @id @default(cuid())
  userId                String?
  profileType           String
  score                 Int?
  answers               Json
  createdAt             DateTime @default(now())
  averageResponseTime   Int?     @map("average_response_time")
  user                  User?    @relation(fields: [userId], references: [id])
  feedback              QuizFeedback?

  @@index([profileType])
  @@index([userId])
  @@map("quiz_result")
}

model QuizFeedback {
  id           String     @id @default(cuid())
  quizResultId String     @unique
  quizResult   QuizResult @relation(fields: [quizResultId], references: [id], onDelete: Cascade)
  isAccurate   Boolean    // "Le résultat vous semble-t-il pertinent ?"
  usefulness   Int        // "Le quiz vous a-t-il été utile ?" (1-5)
  comment      String?    @db.Text
  createdAt    DateTime   @default(now())

  @@map("quiz_feedback")
}

model UXPollResponse {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefersDarkMode Boolean  @default(true)
  modernityRating Int      // 1-5
  readabilityIssues String? @db.Text
  createdAt       DateTime @default(now())

  @@unique([userId]) // One response per user
  @@map("ux_poll_response")
}

model MissionSubmission {
  id                     String   @id @default(cuid())
  userId                 String
  missionId              String
  cycleKey               String   @default("PERMANENT")
  status                 String   @default("PENDING")
  content                String?
  xpAwarded              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  improvementSuggestions String?
  projectDescription     String?
  reviewerFeedback       String?
  userDifficulty         Int?
  userFeedback           String?
  userRating             Int?
  adminFeedback          String?
  reviewerId             String?
  qualityLevel           String?
  revisionCount          Int      @default(0)
  revisionNotes          String?
  reviewerType           String?
  mission                Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user                   User     @relation("SubmissionOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer               User?    @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  reviews                MissionReview[]

  @@unique([userId, missionId, cycleKey])
  @@index([status])
  @@index([userId])
  @@index([missionId])
  @@index([createdAt])
  @@index([status, missionId])
  @@index([status, updatedAt(sort: Desc)])
  @@index([userId, status])                        // ⚡ Dashboard: WHERE userId + status filter
  @@index([userId, createdAt(sort: Desc)])         // ⚡ Dashboard: ORDER BY createdAt DESC par user
  @@map("mission_submission")
}

model MissionReview {
  id            String            @id @default(cuid())
  submissionId  String
  reviewerId    String?
  criteria      Json
  qualityLevel  String
  feedback      String
  revisionNotes String?
  createdAt     DateTime          @default(now())
  submission    MissionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer      User?             @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([submissionId, reviewerId])
  @@index([submissionId])
  @@index([reviewerId])
  @@map("mission_review")
}

model ContactMessage {
  id        String   @id @default(cuid())
  type      String
  email     String
  subject   String
  content   String
  github    String?
  portfolio String?
  skills    String?
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())

  @@index([type])
  @@index([status])
  @@map("contact_message")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String
  title      String
  message    String
  link       String?
  isRead     Boolean  @default(false)
  isSaved    Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([isSaved])
  @@index([isArchived])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notification")
}

model BetaFeedback {
  id            String   @id @default(cuid())
  userId        String
  type          String   // e.g., "BUG", "FEATURE_REQUEST", "GENERAL"
  content       String   @db.Text
  rating        Int?     // User satisfaction rating (1-5)
  status        String   @default("NEW") // e.g., "NEW", "REVIEWED", "RESOLVED"
  attachmentUrl String?  // URL of any attached file (screenshot, etc.)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("beta_feedback")
}

model JoinRequest {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress      String?
  userAgent      String?

  @@unique([userId, organizationId])
  @@map("join_request")
}

model BetaKey {
  id        String    @id @default(cuid())
  key       String    @unique
  isUsed    Boolean   @default(false)
  usedBy    String?   @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("beta_key")
}

model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean? @default(true)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  sourceId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("xp_transaction")
}

model Psychometric {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  builderScore    Int      @default(0)
  creatorScore    Int      @default(0)
  strategistScore Int      @default(0)
  catalystScore   Int      @default(0)
  confidenceScore Float    @default(0.25)

  @@map("psychometric")
}

model UserSocials {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUrl    String?
  portfolioUrl String?
  linkedinUrl  String?
  twitterUrl   String?

  @@map("user_socials")
}

model EngagementStats {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastCheckinAt  DateTime?
  lastStreakDate DateTime?

  @@map("engagement_stats")
}

model FraudEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // FINGERPRINT_SHARED, VPN_DETECTED, PROXY_DETECTED, TOR_DETECTED, EMAIL_TEMPORARY, FRAUD_SCORE_UPDATED
  details   String?  // JSON — flexible payload
  riskDelta Int      @default(0)
  ip        String?
  visitorId String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("fraud_event")
}

model UserLocation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  accuracy  Float?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("user_location")
}

model TeamApplication {
  id                String   @id @default(cuid())
  signalId          String   // Nom ou Pseudo
  whatsapp          String
  country           String
  expertiseVector   String   // BUILDER, CREATOR, STRATEGIST, CATALYST
  proofOfWork       String   // URL Portfolio/GitHub
  cognitiveTest     String   @db.Text // Réponse à la mise en situation
  status            String   @default("PENDING") // PENDING, REVIEWING, ACCEPTED, REJECTED
  createdAt         DateTime @default(now())
  
  @@map("team_application")
}
