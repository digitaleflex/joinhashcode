generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  memberNumber  Int          @unique @default(autoincrement())
  name          String
  email         String       @unique
  emailVerified Boolean
  image         String?
  level         Int          @default(1)
  experience    Int          @default(0)
  class         String?      @map("profile_class") // builder, creator, strategist, catalyst
  role          String       @default("MEMBER") // MEMBER, BUILDER, MENTOR, MODERATOR, OPERATOR, ADMIN
  createdAt     DateTime
  updatedAt     DateTime

  // 1. IDENTITY & BASIC
  pseudo        String?      @unique
  bio           String?
  
  // 2. CONTEXT PERSONNEL
  country       String?
  city          String?
  language      String       @default("fr")
  ageRange      String?      // enum: 15-18, 18-25, 25-35, 35-50, 50+
  currentSituation String?   // Étudiant, Freelance, Salarié, Entrepreneur, Sans emploi, Reconversion

  // 3. CONTEXT TECHNIQUE
  technicalLevel String?     // Débutant, Intermédiaire, Avancé
  domains       String[]     // Web, Cybersecurity, Cloud, IA, Mobile, Data, Automation, UI/UX, DevOps
  tools         String[]     // GitHub, VS Code, Docker, Figma, Cursor, ChatGPT, Vercel, Linux
  githubUrl     String?
  portfolioUrl  String?
  linkedinUrl   String?
  twitterUrl    String?

  // 4. OBJECTIFS UTILISATEUR
  mainObjective     String?  // Trouver emploi, Créer SaaS, Freelance, Créer startup, Cybersécurité, Maîtriser IA, Cloud Computing, Créer produits digitaux
  secondaryObjectives String[]
  dominantMotivation String? // Argent, Passion, Impact, Curiosité, Carrière, Liberté, Innovation
  longTermObjective String?
  preferredRhythm    String? // Intensif, Progressif, Flexible, Week-end uniquement

  // 5. DONNÉES COMPORTEMENTALES
  onboardingSpeed     Int?     // Speed in ms
  answerConsistency   Float?   // Score 0-1
  connectionFrequency Float?   // Score 0-1
  dashboardActivity   Float?   // Score 0-1
  communityEngagement Float?   // Score 0-1

  // 6. DONNÉES PSYCHOMÉTRIQUES (Scores des classes)
  builderScore    Int @default(0)
  creatorScore    Int @default(0)
  strategistScore Int @default(0)
  catalystScore   Int @default(0)
  polarization    Float @default(0)
  profileStability Float @default(0)

  // 7. DONNÉES COMMUNAUTAIRES
  cohortsJoined         String[]
  collaborativeProjects String[]
  mentorId              String?
  mentor                User?    @relation("Mentorship", fields: [mentorId], references: [id])
  mentees               User[]   @relation("Mentorship")

  // 8. DONNÉES DE PROGRESSION
  projectsRealized      String[]
  activePaths           String[]
  badges                String[]
  missionsCompletedCount Int     @default(0)

  // 9. DONNÉES IA / RECOMMANDATION
  recommendedPath          String[]
  recommendedTools         String[]
  predictedEngagementScore Float?
  
  // 10. ADAPTIVE BEHAVIORAL LOOP
  confidenceScore    Float @default(0.25) // 0 to 1
  profileDrift       Float @default(0)    // Difference between Quiz and Actions
  behavioralVibrancy Json?                // Weighted sum of actions: { builder: X, creator: Y, ... }
  lastHypothesisUpdate DateTime?

  // 11. POST-QUIZ & OBJECTIVES (Profil Vivant)
  dreamStatement  String?    // "Dans 12 mois..."
  currentFocus    String[]   // domaines actuels (tech, design, business...)
  mainBlocker     String?    // principal frein (compétences, réseau, temps...)
  lastCheckinAt   DateTime?

  // RELATIONS
  sessions           Session[]
  accounts           Account[]
  quizResults        QuizResult[]
  guildMembers       GuildMember[]
  missionSubmissions MissionSubmission[]
  dailyCheckins      DailyCheckin[]
  notifications      Notification[]

  @@index([level])
  @@index([class])
  @@index([role])
  @@map("user")
}

model DailyCheckin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      String   @db.VarChar(150)
  domain    String
  energy    Int      // 1-5
  duration  Int      // in minutes
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("daily_checkin")
}

model Mission {
  id          String   @id @default(cuid())
  title       String
  shortDesc   String?
  description String
  slug        String   @unique
  category    String   // tech, design, business, community
  difficulty  Int      @default(1)
  xp          Int      @default(100)
  
  // Profil Vivant fields
  targetProfiles String[] // builder, creator, strategist, catalyst
  missionLevel   String?  // INIT, CORE, PRO
  requirements   String[]
  duration       String?  // e.g., "2h", "4h"

  // Behavioral Weights (Vecteurs)
  weightBuilder    Float @default(0)
  weightCreator    Float @default(0)
  weightStrategist Float @default(0)
  weightCatalyst   Float @default(0)

  fullBriefing      String?  @db.Text
  submissionMethod  String   @default("ANY_LINK")
  deliverables      String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  submissions MissionSubmission[]

  @@index([category])
  @@index([difficulty])
  @@map("mission")
}

model Guild {
  id            String        @id @default(cuid())
  name          String
  description   String?
  slug          String        @unique
  requiredLevel Int           @default(1)
  isPrivate     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  members       GuildMember[]

  @@map("guild")
}

model GuildMember {
  id        String   @id @default(cuid())
  userId    String
  guildId   String
  role      String   @default("MEMBER") // MEMBER, MODERATOR, LEADER
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId])
  @@index([userId])
  @@index([guildId])
  @@map("guild_member")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model QuizResult {
  id                    String   @id @default(cuid())
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id])
  profileType           String   // builder, creator, strategist, catalyst
  score                 Int?
  answers               Json     // Store the raw answers for analysis
  averageResponseTime   Int?     @map("average_response_time") // Average time in ms
  detailedResponseTimes Json?    @map("detailed_response_times") // Array of times per question
  diagnosticAnswers     Json?    @map("diagnostic_answers")
  createdAt             DateTime @default(now())

  @@index([profileType])
  @@map("quiz_result")
}

model MissionSubmission {
  id                    String   @id @default(cuid())
  userId                String
  missionId             String
  status                String   @default("PENDING") // PENDING, APPROVED, REJECTED
  content               String?  // The URL or text submitted by the user
  
  // Feedback Utilisateur (Post-Submission)
  projectDescription    String?  @db.Text
  userDifficulty        Int?     // 1 to 5
  userRating            Int?     // 1 to 5
  userFeedback          String?  @db.Text
  improvementSuggestions String? @db.Text

  adminFeedback         String?  @db.Text
  reviewerId            String?
  reviewerFeedback      String?  // Feedback from the reviewer/mentor
  xpAwarded             Int      @default(0)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([status])
  @@index([userId])
  @@index([missionId])
  @@index([createdAt])
  @@map("mission_submission")
}

model ContactMessage {
  id        String   @id @default(cuid())
  type      String   // support, suggestion, partner
  email     String
  subject   String
  content   String
  status    String   @default("UNREAD") // UNREAD, READ, ARCHIVED
  createdAt DateTime @default(now())

  @@index([type])
  @@index([status])
  @@map("contact_message")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // MISSION_APPROVED, LEVEL_UP, DAILY_REMINDER, SYSTEM
  title     String
  message   String   @db.Text
  link      String?  // e.g., /missions
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notification")
}
