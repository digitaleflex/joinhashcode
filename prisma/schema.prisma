generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean
  image         String?
  level         Int          @default(1)
  experience    Int          @default(0)
  class         String?      @map("profile_class") // builder, creator, strategist, catalyst
  role          String       @default("MEMBER") // MEMBER, MODERATOR, ADMIN
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  quizResults   QuizResult[]
  guildMembers  GuildMember[]

  @@map("user")
}

model Guild {
  id            String        @id @default(cuid())
  name          String
  description   String?
  slug          String        @unique
  requiredLevel Int           @default(1)
  isPrivate     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  members       GuildMember[]

  @@map("guild")
}

model GuildMember {
  id        String   @id @default(cuid())
  userId    String
  guildId   String
  role      String   @default("MEMBER") // MEMBER, MODERATOR, LEADER
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId])
  @@map("guild_member")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model QuizResult {
  id                    String   @id @default(cuid())
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id])
  profileType           String   // builder, creator, strategist, catalyst
  score                 Int?
  answers               Json     // Store the raw answers for analysis
  averageResponseTime   Int?     @map("average_response_time") // Average time in ms
  detailedResponseTimes Json?    @map("detailed_response_times") // Array of times per question
  createdAt             DateTime @default(now())

  @@index([profileType])
  @@map("quiz_result")
}
