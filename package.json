{
  "name": "my-project",
  "version": "2.6.3",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "clean": "rm -rf .next/cache",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && npm run dev",
    "build": "npm run clean && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "verify": "bash scripts/verify.sh",
    "verify:fast": "bash scripts/verify.sh --fast",
    "db:seed": "tsx prisma/seed.ts",
    "hef:parse": "node scripts/hef/parse.mjs",
    "hef:validate": "node scripts/hef/validate.mjs",
    "hef:seed": "tsx prisma/seed-hef.ts",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "check-secrets": "node scripts/check-secrets.js",
    "security-scan": "pnpm audit && pnpm check-secrets",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "docs": "typedoc",
    "prepare": "husky"
  },
