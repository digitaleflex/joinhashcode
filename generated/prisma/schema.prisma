generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String              @id
  name                     String
  email                    String              @unique
  emailVerified            Boolean
  image                    String?
  createdAt                DateTime
  updatedAt                DateTime
  level                    Int                 @default(1)
  experience               Int                 @default(0)
  class                    String?             @map("profile_class")
  role                     String              @default("MEMBER")
  activePaths              String[]
  ageRange                 String?
  answerConsistency        Float?
  badges                   String[]
  behavioralVibrancy       Json?
  builderScore             Int                 @default(0)
  catalystScore            Int                 @default(0)
  city                     String?
  cohortsJoined            String[]
  collaborativeProjects    String[]
  communityEngagement      Float?
  confidenceScore          Float               @default(0.25)
  connectionFrequency      Float?
  country                  String?
  creatorScore             Int                 @default(0)
  currentSituation         String?
  dashboardActivity        Float?
  domains                  String[]
  dominantMotivation       String?
  githubUrl                String?
  language                 String              @default("fr")
  lastHypothesisUpdate     DateTime?
  longTermObjective        String?
  mainObjective            String?
  mentorId                 String?
  missionsCompletedCount   Int                 @default(0)
  onboardingSpeed          Int?
  polarization             Float               @default(0)
  portfolioUrl             String?
  predictedEngagementScore Float?
  preferredRhythm          String?
  profileDrift             Float               @default(0)
  profileStability         Float               @default(0)
  projectsRealized         String[]
  pseudo                   String?             @unique
  recommendedPath          String[]
  recommendedTools         String[]
  strategistScore          Int                 @default(0)
  technicalLevel           String?
  tools                    String[]
  secondaryObjectives      String[]
  bio                      String?
  linkedinUrl              String?
  memberNumber             Int                 @unique @default(autoincrement())
  twitterUrl               String?
  currentFocus             String[]
  dreamStatement           String?
  lastCheckinAt            DateTime?
  mainBlocker              String?
  accounts                 Account[]
  dailyCheckins            DailyCheckin[]
  guildMembers             GuildMember[]
  missionSubmissions       MissionSubmission[] @relation("SubmissionOwner")
  submissionsInReview      MissionSubmission[] @relation("SubmissionReviewer")
  canReviewProfiles        String[]            @default([])
  reviewsCompleted         Int                 @default(0)
  reviewsGiven             MissionReview[]     @relation("ReviewsGiven")
  notifications            Notification[]
  quizResults              QuizResult[]
  sessions                 Session[]
  mentor                   User?               @relation("Mentorship", fields: [mentorId], references: [id])
  mentees                  User[]              @relation("Mentorship")

  @@index([level])
  @@index([class])
  @@index([role])
  @@map("user")
}

model DailyCheckin {
  id        String   @id @default(cuid())
  userId    String
  note      String   @db.VarChar(150)
  domain    String
  energy    Int
  duration  Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("daily_checkin")
}

model Mission {
  id                 String              @id @default(cuid())
  title              String
  description        String
  slug               String              @unique
  category           String
  difficulty         Int                 @default(1)
  xp                 Int                 @default(100)
  weightBuilder      Float               @default(0)
  weightCreator      Float               @default(0)
  weightStrategist   Float               @default(0)
  weightCatalyst     Float               @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  duration           String?
  missionLevel       String?
  requirements       String[]
  shortDesc          String?
  targetProfiles     String[]
  deliverables       String[]
  fullBriefing       String?
  submissionMethod   String              @default("ANY_LINK")
  acceptanceCriteria Json                @default("[]")
  evaluatorNotes     String?
  qualityIndicators  Json                @default("[]")
  submissions        MissionSubmission[]

  @@index([category])
  @@index([difficulty])
  @@map("mission")
}

model Guild {
  id            String        @id @default(cuid())
  name          String
  description   String?
  slug          String        @unique
  requiredLevel Int           @default(1)
  isPrivate     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  members       GuildMember[]

  @@map("guild")
}

model GuildMember {
  id       String   @id @default(cuid())
  userId   String
  guildId  String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId])
  @@index([userId])
  @@index([guildId])
  @@map("guild_member")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model QuizResult {
  id                    String   @id @default(cuid())
  userId                String?
  profileType           String
  score                 Int?
  answers               Json
  createdAt             DateTime @default(now())
  averageResponseTime   Int?     @map("average_response_time")
  detailedResponseTimes Json?    @map("detailed_response_times")
  diagnosticAnswers     Json?    @map("diagnostic_answers")
  user                  User?    @relation(fields: [userId], references: [id])

  @@index([profileType])
  @@map("quiz_result")
}

model MissionSubmission {
  id                     String          @id @default(cuid())
  userId                 String
  missionId              String
  status                 String          @default("PENDING")
  content                String?
  xpAwarded              Int             @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  improvementSuggestions String?
  projectDescription     String?
  reviewerFeedback       String?
  userDifficulty         Int?
  userFeedback           String?
  userRating             Int?
  adminFeedback          String?
  reviewerId             String?
  qualityLevel           String?
  revisionCount          Int             @default(0)
  revisionNotes          String?
  reviewerType           String?
  mission                Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user                   User            @relation("SubmissionOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer               User?           @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  reviews                MissionReview[]

  @@unique([userId, missionId])
  @@index([status])
  @@index([userId])
  @@index([missionId])
  @@index([createdAt])
  @@map("mission_submission")
}

model MissionReview {
  id            String            @id @default(cuid())
  submissionId  String
  reviewerId    String
  criteria      Json
  qualityLevel  String
  feedback      String
  revisionNotes String?
  createdAt     DateTime          @default(now())
  submission    MissionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer      User              @relation("ReviewsGiven", fields: [reviewerId], references: [id])

  @@unique([submissionId, reviewerId])
  @@index([submissionId])
  @@index([reviewerId])
  @@map("mission_review")
}

model ContactMessage {
  id        String   @id @default(cuid())
  type      String
  email     String
  subject   String
  content   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())

  @@index([type])
  @@index([status])
  @@map("contact_message")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notification")
}
