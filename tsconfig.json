{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "better-auth/adapters/*": [
        "node_modules/better-auth/dist/adapters/*/index.d.mts"
      ],
      "better-auth/plugins/*": [
        "node_modules/better-auth/dist/plugins/*/index.d.mts"
      ],
      "better-auth/next-js": [
        "node_modules/better-auth/dist/integrations/next-js.d.mts"
      ],
      "better-auth/react": [
        "node_modules/better-auth/dist/client/react/index.d.mts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
