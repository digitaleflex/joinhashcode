{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "proxy.ts",
    "instrumentation.ts",
    "cluster.mjs",
    "app/**/{page,layout,route,loading,error,not-found,global-error,template,default,sitemap,robots,opengraph-image}.{ts,tsx}",
    "app/actions/**/*.ts",
    "lib/actions/**/*.ts",
    "prisma/*.ts",
    "scripts/**/*.{ts,mjs,js}",
    "playwright.*.config.ts",
    "types/**/*.d.ts"
  ],
  "project": [
    "**/*.{ts,tsx,mjs}"
  ],
  "ignore": [
    "generated/**"
  ],
  "ignoreDependencies": [
    "@next/eslint-plugin-next",
    "@typescript-eslint/parser",
    "eslint-config-next",
    "postcss-load-config",
    "sharp",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "components/ui/**": [
      "exports",
      "types"
    ]
  },
  "rules": {
    "types": "off"
  }
}
