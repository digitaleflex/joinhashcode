{
  "general": {
    "plan": {
      "enabled": true
    },
    "sessionRetention": {
      "enabled": true,
      "maxAge": "7d"
    }
  },
  "model": {
    "compressionThreshold": 0.5,
    "disableLoopDetection": false
  },
  "ui": {
    "footer": {
      "hideCWD": true
    }
  },
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    }
  }
}
