# --- MANDATORY AUTH ---
BETTER_AUTH_SECRET="your_generated_secret_here"
BETTER_AUTH_URL="https://your-domain.com" # Root URL of your app

# --- DATABASE ---
# Pour Docker local interne (dans le réseau de conteneurs) :
# DATABASE_URL="postgresql://postgres:localpassword@db:5432/hashcode?schema=public"
# Pour votre machine locale pointant vers le conteneur Docker (port 5432 exposé) :
DATABASE_URL="postgresql://postgres:localpassword@localhost:5432/hashcode?schema=public"
# Pour la production / Supabase (avec SSL exigé) :
# DATABASE_URL="postgresql://user:password@host:port/db?sslmode=require"
DIRECT_URL="postgresql://postgres:localpassword@localhost:5432/hashcode?schema=public"

# --- AUTH PROVIDERS ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- EMAILS (RESEND) ---
RESEND_API_KEY="re_..."

# --- STORAGE (SUPABASE) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- NOTIFICATIONS (QSTASH) ---
QSTASH_TOKEN="ey..."
QSTASH_CURRENT_SIGNING_KEY="sig_..."
QSTASH_NEXT_SIGNING_KEY="sig_..."

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# --- DEPLOYMENT ---
NODE_ENV="production"
