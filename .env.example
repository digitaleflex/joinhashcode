# --- MANDATORY AUTH ---
BETTER_AUTH_SECRET="your_generated_secret_here"
BETTER_AUTH_URL="https://your-domain.com" # Root URL of your app

# --- DATABASE ---
DATABASE_URL="postgresql://user:password@host:port/db?sslmode=require"

# --- AUTH PROVIDERS ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- EMAILS (RESEND) ---
RESEND_API_KEY="re_..."

# --- QSTASH ---
QSTASH_TOKEN=""

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# --- DEPLOYMENT ---
NODE_ENV="production"
