# --- MANDATORY AUTH ---
BETTER_AUTH_SECRET="your_generated_secret_here"
BETTER_AUTH_URL="https://your-domain.com" # Root URL of your app

# --- DATABASE ---
# Pour Docker local interne (dans le réseau de conteneurs) :
# DATABASE_URL="postgresql://postgres:localpassword@db:5432/hashcode?schema=public"
# Pour votre machine locale pointant vers le conteneur Docker (port 5432 exposé) :
DATABASE_URL="postgresql://postgres:localpassword@localhost:5432/hashcode?schema=public"
# Pour la production / Supabase (avec SSL exigé) :
# DATABASE_URL="postgresql://user:password@host:port/db?sslmode=require"
DIRECT_URL="postgresql://postgres:localpassword@localhost:5432/hashcode?schema=public"

# --- AUTH PROVIDERS ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- EMAILS (RESEND) ---
RESEND_API_KEY="re_..."


# --- NOTIFICATIONS & QUEUES (QSTASH) ---
QSTASH_TOKEN="ey..."
QSTASH_CURRENT_SIGNING_KEY="sig_..."
QSTASH_NEXT_SIGNING_KEY="sig_..."

# --- RATE LIMITING (UPSTASH REDIS) ---
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# --- APP CONFIG & SECURITY ---
NEXT_PUBLIC_APP_URL="https://your-domain.com"
CRON_SECRET="your_32_chars_secret_here"
TRUSTED_PROXIES="127.0.0.1" # Optionnel, pour le déploiement derrière un proxy

# --- ANTI-FRAUD (ProxyD) ---
# ProxyD est un service self-hosté de détection proxy/VPN/TOR (MIT, Rust)
# docker run -d --name proxyd -p 7891:7891 -v proxyd-data:/data networkcat/proxyd
# Laissez vide pour désactiver le check (ou sur NODE_ENV=development)
PROXYD_URL="http://127.0.0.1:7891"

# --- DEPLOYMENT ---
NODE_ENV="production"
